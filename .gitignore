build/
__pycache__/
# The plugin's build output
/Plugin/OnlyWorlds/Binaries/
/Plugin/OnlyWorlds/Intermediate/
# The host project's build output, caches and logs
/Host/Binaries/
/Host/Intermediate/
/Host/Saved/
/Host/DerivedDataCache/
/Host/.vs/
# What the editor writes into a project on its first start (the host needs none of it), but the one config file the
# packaged game needs (DefaultGame.ini: the graphs' folder always cooked)
/Host/Config/*
!/Host/Config/DefaultGame.ini
# The host's content: generated, never committed (Content/OW/, the Blueprint graphs -run=OWMakeGraph writes)
/Host/Content/
/Host/*.sln
