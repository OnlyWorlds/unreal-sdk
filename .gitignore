build/
__pycache__/
# The plugin's build output
/Plugin/OnlyWorlds/Binaries/
/Plugin/OnlyWorlds/Intermediate/
# The host project's build output, caches and logs
/Host/Binaries/
/Host/Intermediate/
/Host/Saved/
/Host/DerivedDataCache/
/Host/.vs/
# What the editor writes into a project on its first start (the host needs neither)
/Host/Config/
/Host/Content/
/Host/*.sln
